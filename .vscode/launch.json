{
  "version": "0.2.0",

  "inputs": [
    {
      "id": "userQuery",
      "type": "promptString",
      "description": "Enter user query",
      "default": "what's showing on 18th Jan?"
    }
  ],

  "configurations": [
    {
      "name": "Debug parse_intent experiments",
      "type": "python",
      "request": "launch",
      "module": "experiments.parse_intent.run_experiments",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug kl_mcp_rag.app (module)",
      "type": "python",
      "request": "launch",
      "module": "kl_mcp_rag.app",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug System (s3 listings)",
      "type": "python",
      "request": "launch",
      "module": "kl_mcp_rag.pipeline_handler",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "--user-query",
        "king of new york",
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug System - local listings",
      "type": "python",
      "request": "launch",
      "module": "kl_mcp_rag.pipeline_handler",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "--user-query",
        "Hamnet",
        "--raw-listings-path",
        "raw_listings_v1.json"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "BUILD (λ)",
      "type": "node-terminal",
      "request": "launch",
      "command": "./build_lambda_light.sh",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "DEPLOY (λ)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/lambda_deploy.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Build Film Index (S3)",
      "type": "python",
      "request": "launch",
      "module": "kl_mcp_rag.rag.build_index",
      "console": "integratedTerminal"
    },
    {
      "name": "Build Film Index (Local JSON)",
      "type": "python",
      "request": "launch",
      "module": "kl_mcp_rag.rag.build_index",
      "args": [
        "--raw-path",
        "raw_listings_v1.json"
      ],
      "console": "integratedTerminal"
    }
  ]
}
