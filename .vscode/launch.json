{
  "version": "0.2.0",

  "inputs": [
    {
      "id": "userQuery",
      "type": "promptString",
      "description": "Enter user query",
      "default": "what's showing on 18th Jan?"
    }
  ],

  "configurations": [
    {
      "name": "Debug parse_intent experiments",
      "type": "python",
      "request": "launch",
      "module": "experiments.parse_intent.run_experiments",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug kl_mcp_rag.app (module)",
      "type": "python",
      "request": "launch",
      "module": "kl_mcp_rag.app",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug Pipeline (HARD CODE)",
      "type": "python",
      "request": "launch",
      "module": "kl_mcp_rag.pipeline_handler",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "--user-query",
        "Hamnet",
        "--raw-listings-path",
        "raw_listings_v1.json"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug Pipeline",
      "type": "python",
      "request": "launch",
      "module": "kl_mcp_rag.pipeline_handler",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "--user-query",
        "${input:userQuery}",
        "--raw-listings-path",
        "raw_listings_v1.json"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}